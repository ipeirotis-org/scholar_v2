# GCP project and credentials
GCP_PROJECT_ID=scholar-version2
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# BigQuery datasets
BQ_DATASET=scholar_raw_data
BQ_STATS_DATASET=statistics

# Cloud Tasks
QUEUE_LOCATION=northamerica-northeast1
QUEUE_NAME_CACHE_PRIORITY=cache-priority
QUEUE_NAME_CACHE_BATCH=cache-batch

# Cache Layer (Cloud Run service URL)
CACHE_LAYER_URL=http://localhost:8081
CACHE_LAYER_ADMIN_TOKEN=

# Frontend
SECRET_KEY=
GA_TRACKING_ID=G-P3R50RQS24
CLOUD_TASKS_SA_EMAIL=875626982900-compute@developer.gserviceaccount.com

# Cache Layer — materialized tables (set to "true" after first materialization)
USE_MATERIALIZED_TABLES=false

# GCS
GCS_BUCKET=scholar_data_share
